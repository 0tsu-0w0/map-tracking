# このファイルを .env にコピーして値を入れる(.env は Git に入れない)

# 案B(自作 API + DB)を使うときは、次の行のコメントを外す。
# 以後の docker compose コマンドは compose.b.yaml を使う(未設定なら案A の compose.yaml)
# COMPOSE_FILE=compose.b.yaml

# ===== 共通 =====
# 公開するドメイン(どちらも DNS の A レコードをサーバーに向けておく)
MQTT_DOMAIN=mqtt.example.com
APP_DOMAIN=map.example.com
# Let's Encrypt に登録するメールアドレス(証明書の期限切れ通知が届く)
ACME_EMAIL=you@example.net
TZ=Asia/Tokyo

# ===== 案A(Recorder)=====
# 地図画面(Recorder)のログイン
WEB_USER=admin
# scripts/hash-web-password.sh で作ったハッシュを「シングルクォートで囲んで」貼る
# 例: WEB_PASS_HASH='$2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
WEB_PASS_HASH=
# Recorder が Mosquitto に接続するときのアカウント(scripts/init.sh が登録する)
RECORDER_MQTT_USER=recorder
RECORDER_MQTT_PASS=change-me-long-random-string

# ===== 案B(自作 API + PostgreSQL/PostGIS)=====
# API が Mosquitto に接続するときのアカウント(scripts/init.sh が登録する)
# 案A だけ使うなら空のままでよい
API_MQTT_USER=api
API_MQTT_PASS=
# DB のパスワード(長いランダム文字列にする)
DB_PASSWORD=
# 最初の管理者(初回起動時に作られる。作成後は消してよい)
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASS=
# 履歴の保存日数(0 なら自動削除しない)
RETENTION_DAYS=365
# 背景地図のスタイル URL(空なら国土地理院の標準地図)
# 例: https://api.maptiler.com/maps/streets-v2/style.json?key=<API キー>
MAP_STYLE_URL=
# 位置が届かなくなったら通知する Webhook(Slack / Discord 形式)。空なら通知しない
ALERT_WEBHOOK_URL=
ALERT_STALE_HOURS=0
# OwnTracks 側の Regions の出入りも上の Webhook に通知するか(画面で登録した場所は、場所ごとに設定)
NOTIFY_DEVICE_TRANSITIONS=true
# バックアップ(./backups)を何世代残すか
BACKUP_KEEP=7
